{
  "name": "django-vscode",
  "displayName": "Django Extension",
  "description": "VS Code extension for Django development",
  "icon": "media/icons/logo-marketplace.png",
  "keywords": [
    "django",
    "python",
    "web framework",
    "api",
    "rest",
    "openapi",
    "django-rest-framework",
    "drf"
  ],
  "version": "0.1.0",
  "publisher": "DjangoLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/django/django-vscode"
  },
  "bugs": {
    "url": "https://github.com/django/django-vscode/issues"
  },
  "homepage": "https://github.com/django/django-vscode#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.py"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "qna": false,
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "django-vscode.refreshPathOperations",
        "title": "Refresh Path Operations",
        "category": "Django",
        "icon": "$(refresh)"
      },
      {
        "command": "django-vscode.toggleRouters",
        "title": "Toggle Expand/Collapse Routers",
        "category": "Django",
        "icon": "$(fold)"
      },
      {
        "command": "django-vscode.copyPathOperationPath",
        "title": "Copy Path to Path Operation",
        "category": "Django"
      },
      {
        "command": "django-vscode.goToRouter",
        "title": "Go to Router Definition",
        "category": "Django"
      },
      {
        "command": "django-vscode.reportIssue",
        "title": "Report Issue...",
        "category": "Django"
      },
      {
        "command": "django-vscode.searchPathOperations",
        "title": "Search Path Operations...",
        "category": "Django",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "django-vscode.searchPathOperations",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "django-vscode.copyPathOperationPath",
          "when": "false"
        },
        {
          "command": "django-vscode.goToRouter",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "django-vscode.refreshPathOperations",
          "when": "view == path-operation-explorer",
          "group": "navigation@1"
        },
        {
          "command": "django-vscode.toggleRouters",
          "when": "view == path-operation-explorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "django-vscode.copyPathOperationPath",
          "when": "view == path-operation-explorer && viewItem == route",
          "group": "navigation"
        },
        {
          "command": "django-vscode.goToRouter",
          "when": "view == path-operation-explorer && viewItem == router",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "django",
          "title": "Django",
          "icon": "media/icons/logo-outline.svg"
        }
      ]
    },
    "views": {
      "django": [
        {
          "id": "path-operation-explorer",
          "name": "Path Operation Explorer",
          "icon": "media/icons/logo-outline.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "path-operation-explorer",
        "contents": "No Django apps found in this workspace.\n\n[Configure Entry Point](command:workbench.action.openSettings?[\"django.entryPoint\"])\n\n[Open Getting Started](command:workbench.action.openWalkthrough?{\"category\":\"DjangoLabs.django-vscode#django-getting-started\"})"
      }
    ],
    "walkthroughs": [
      {
        "id": "django-getting-started",
        "title": "Get Started with Django",
        "description": "Learn how to use the Django extension to boost your productivity",
        "icon": "media/icons/logo-teal.svg",
        "steps": [
          {
            "id": "view-path-operations",
            "title": "View Your Path Operations",
            "description": "Open the Path Operation Explorer in the Activity Bar (⚡) to see all routes in your Django application.\n[Open Path Operation Explorer](command:path-operation-explorer.focus)",
            "media": {
              "image": "media/walkthrough/path-operations.gif",
              "altText": "Path Operation Explorer showing Django routes organized by router"
            },
            "completionEvents": [
              "onView:path-operation-explorer"
            ]
          },
          {
            "id": "search-path-operations",
            "title": "Quickly Find Path Operations",
            "description": "Instantly filter and navigate to any path operation in your application.\n[Search Path Operations](command:django-vscode.searchPathOperations)",
            "media": {
              "image": "media/walkthrough/search.gif",
              "altText": "Search path operations quick pick showing filtered results"
            },
            "completionEvents": [
              "onCommand:django-vscode.searchPathOperations"
            ]
          },
          {
            "id": "codelens",
            "title": "Navigate from Tests to Routes",
            "description": "CodeLens links appear above test client calls to jump directly to the route definition.",
            "media": {
              "image": "media/walkthrough/codelens.gif",
              "altText": "CodeLens link above test client call"
            }
          },
          {
            "id": "feedback",
            "title": "Give Feedback & Get Help",
            "description": "Help us improve! Report bugs, request features, or contribute to the project.\n\n[Report an Issue](command:django-vscode.reportIssue)\n[View on GitHub](https://github.com/django/django-vscode)",
            "media": {
              "image": "media/walkthrough/feedback.gif",
              "altText": "Django extension output panel showing debug logs"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Django",
      "properties": {
        "django.entryPoint": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Entrypoint for the root Django URLconf in module:variable notation (e.g., 'myproject.urls:urlpatterns'). If not set, the extension will search settings.py and common locations."
        },
        "django.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show CodeLens links above test client calls (e.g., client.get('/items')) to navigate to the corresponding route definition."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run esbuild.js --production",
    "compile": "bun run esbuild.js",
    "watch": "bun run esbuild.js --watch",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "lint": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true src/",
    "test": "bun run compile && vscode-test",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:web": "bun run compile && bunx @vscode/test-web --extensionDevelopmentPath=. --browserType=none",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/bun": "latest",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "path-browserify": "^1.0.1",
    "sinon": "^21.0.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "toml": "^3.0.0",
    "web-tree-sitter": "^0.26.3"
  },
  "lint-staged": {
    "**/*.{ts,js,json}": [
      "biome check --write"
    ]
  }
}
